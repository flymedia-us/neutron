          }
        }
      }
    },
    "Steam was installed by another account on this Mac. Only that account can modify it. Log in to macOS with that account to reinstall Neutron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wurde von einem anderen Benutzer auf diesem Mac installiert. Nur dieser Benutzer kann es ändern. Melde dich mit diesem Benutzer bei macOS an, um Neutron neu zu installieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a été installé par un autre compte sur ce Mac. Seul ce compte peut le modifier. Connectez-vous à macOS avec ce compte pour réinstaller Neutron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato installato da un altro account su questo Mac e solo quell'account può modificarlo. Accedi a macOS con quell'account per reinstallare Neutron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 由这台 Mac 上的其他账户安装，只有该账户可以修改。请登录该账户，重新安装 Neutron。"
          }
        }
      }
    },
    "Steam was stopped, so start it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wurde beendet, starte es also erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam a été arrêté, relancez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è stato chiuso: riavvialo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已停止，请重新启动。"
          }
        }
      }
    },
    "Steam's default is %@. Turn on to use Highball instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Steam ist %@ als Standard eingestellt. Aktivieren Sie diese Option, um Highball zu verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil par défaut de Steam est %@. Activez cette option pour utiliser Highball."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Steam's default is %@. Turn on to use Highball instead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 的默认工具是 %@。打开此项以改用 Highball。"
          }
        }
      }
    },
    "Steam's default tool is cleared at the next Steam start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim nächsten Start von Steam wird das Standard-Kompatibilitätswerkzeug aufgehoben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil de compatibilité par défaut sera effacé au prochain lancement de Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Steam's default tool is cleared at the next Steam start."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次启动 Steam 时将清除 Steam 的默认工具。"
          }
        }
      }
    },
    "Steam's installed dylib does not match this account's build record. Finish or repair its installation with the Neutron app that last installed it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die installierte dylib von Steam passt nicht zum Build-Eintrag dieses Benutzers. Schließe die Installation mit der Neutron-App ab, die sie zuletzt installiert hat, oder repariere sie damit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installée de Steam ne correspond pas à l'enregistrement de build de ce compte. Terminez ou réparez son installation avec l'app Neutron qui l'a installée en dernier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dylib installata in Steam non corrisponde alla build registrata per questo account. Completa o ripara l'installazione con l'app Neutron che l'ha installata per ultima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中已安装的动态库与当前账户的版本记录不一致。请使用上次执行安装的 Neutron 应用完成或修复安装。"
          }
        }
      }
    },
    "Steam's location changed. Start setup again for the selected copy of Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherort von Steam hat sich geändert. Starten Sie die Einrichtung für die ausgewählte Steam-Kopie erneut."
