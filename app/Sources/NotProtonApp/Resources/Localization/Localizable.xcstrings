      }
    },
    "Steam" : {
      "shouldTranslate" : false
    },
    "Steam at %@ isn't connected, so Neutron can't be removed from it. All other Neutron data is removed, except for Windows Games and prefixes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam unter %@ ist nicht verbunden, daher kann Neutron dort nicht entfernt werden. Alle anderen Neutron-Daten werden entfernt, außer Windows-Spielen und Präfixen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam à %@ n'est pas connecté, Neutron ne peut donc pas en être supprimé. Toutes les autres données de Neutron sont supprimées, sauf les jeux Windows et les préfixes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato, quindi Neutron non può esserne rimosso. Tutti gli altri dati di Neutron vengono rimossi, tranne i giochi Windows e i prefissi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接，因此无法从中移除 Neutron。其他所有 Neutron 数据都会被移除，但 Windows 游戏及游戏容器除外。"
          }
        }
      }
    },
    "Steam at %@ isn't connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam unter %@ ist nicht verbunden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam à %@ n'est pas connecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam in %@ non è collegato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位于 %@ 的 Steam 未连接。"
          }
        }
      }
    },
    "Steam client updates are allowed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Client-Updates sind erlaubt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du client Steam sont autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono consentiti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已允许 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates are blocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Client-Updates sind blockiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du client Steam sont bloquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam sono bloccati."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已阻止 Steam 客户端更新。"
          }
        }
      }
    },
    "Steam client updates may break Neutron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Client-Updates können Neutron unbrauchbar machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du client Steam peuvent casser Neutron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Neutron inutilizzabile."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Neutron 无法使用。"
          }
        }
      }
    },
    "Steam client updates may break Neutron. If you don't want to wait for Neutron to be updated to be compatible with future Steam versions at the cost of not getting updates to the Steam client, you can stop the Steam client from updating itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam-Client-Updates können Neutron unbrauchbar machen. Wenn du nicht warten willst, bis Neutron an künftige Steam-Versionen angepasst ist, kannst du verhindern, dass sich der Steam-Client selbst aktualisiert. Dafür erhältst du dann keine Updates mehr für den Steam-Client."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour du client Steam peuvent casser Neutron. Si vous ne voulez pas attendre que Neutron soit adapté aux futures versions de Steam, vous pouvez empêcher le client Steam de se mettre à jour, au prix de ne plus recevoir ses mises à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti del client Steam potrebbero rendere Neutron inutilizzabile. Se non vuoi aspettare che Neutron venga aggiornato per le future versioni di Steam, puoi impedire al client Steam di aggiornarsi, rinunciando però ai suoi aggiornamenti."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 客户端更新可能导致 Neutron 无法使用。你可以阻止 Steam 自动更新，避免等待 Neutron 适配新版本，但这也意味着无法及时获得 Steam 客户端的功能改进和安全更新。"
          }
        }
      }
    },
    "Steam could not be fully restored. Please run Repair Steam again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam konnte nicht vollständig wiederhergestellt werden. Bitte führe „Steam reparieren“ erneut aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam n'a pas pu être entièrement restauré. Relancez « Réparer Steam »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile ripristinare completamente Steam. Esegui di nuovo Ripara Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未能完全恢复 Steam。请再次执行“修复 Steam”。"
          }
        }
      }
    },
    "Steam has a different copy of Neutron, installed by another account on this Mac. Update Neutron from that account, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam enthält eine andere Neutron-Kopie, die von einem anderen Benutzer auf diesem Mac installiert wurde. Aktualisiere Neutron über diesen Benutzer und versuche es dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam contient une autre copie de Neutron, installée par un autre compte sur ce Mac. Mettez à jour Neutron depuis ce compte, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ha una copia diversa di Neutron, installata da un altro account su questo Mac. Aggiorna Neutron da quell'account, poi riprova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 中的另一份 Neutron 是由本机其他账户安装的。请使用该账户更新 Neutron，然后重试。"
          }
        }
      }
    },
    "Steam has not been set up for Neutron, and this account cannot change it. Install from the account that owns Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wurde nicht für Neutron eingerichtet, und dieser Benutzer kann das nicht ändern. Installiere über den Benutzer, dem Steam gehört."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam n'a pas été configuré pour Neutron et ce compte ne peut pas le modifier. Installez depuis le compte propriétaire de Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam non è stato configurato per Neutron e questo account non può modificarlo. Installa dall'account a cui appartiene Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 尚未配置 Neutron，当前账户无权修改。请使用安装 Steam 的账户执行安装。"
          }
        }
      }
    },
    "Steam integration needs repair." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Steam-Integration muss repariert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intégration à Steam doit être réparée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'integrazione con Steam va riparata."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 集成需要修复。"
          }
        }
      }
    },
    "Steam is restored to its unmodified state and Neutron is removed, including the compatibility tool that lives inside the Steam folder. Windows games and Steam Play prefixes are not removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam wird in den unveränderten Zustand zurückversetzt und Neutron entfernt, einschließlich des Kompatibilitätstools im Steam-Ordner. Windows-Spiele und Steam Play-Präfixe werden nicht entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam est restauré dans son état non modifié et Neutron est supprimé, y compris l'outil de compatibilité situé dans le dossier Steam. Les jeux Windows et les préfixes Steam Play ne sont pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam viene riportato allo stato originale e Neutron viene rimosso, compreso lo strumento di compatibilità nella cartella di Steam. I giochi Windows e i prefissi di Steam Play non vengono rimossi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会将 Steam 恢复为未修改的状态，并移除 Neutron（包括 Steam 文件夹内的兼容工具）。不会删除 Windows 游戏及 Steam Play 游戏容器。"
          }
        }
      }
    },
    "Steam is running" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam läuft"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam est ouvert"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行"
          }
        }
      }
    },
    "Steam is running, please close Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam läuft, bitte schließe Steam."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam est ouvert, veuillez fermer Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è in esecuzione, chiudi Steam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 正在运行，请先关闭 Steam。"
          }
        }
      }
    },
    "Steam is set up to inject a different dylib. Please repair Steam before installing Neutron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam ist so eingerichtet, dass eine andere dylib geladen wird. Bitte repariere Steam, bevor du Neutron installierst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam est configuré pour injecter une autre dylib. Réparez Steam avant d'installer Neutron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam è configurato per caricare una dylib diversa. Ripara Steam prima di installare Neutron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam 已配置为注入其他动态库。请先修复 Steam，再安装 Neutron。"
