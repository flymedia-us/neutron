          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 Steam 应用包。预期 Identifier=%@。"
          }
        }
      }
    },
    "%@ is not there, so there is nothing to install into." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht vorhanden, daher gibt es kein Installationsziel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est introuvable, il n'y a donc rien où installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non c'è, quindi non c'è niente in cui installare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不存在，无法安装。"
          }
        }
      }
    },
    "%@ is running. Quit the game first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft. Beende zuerst das Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
