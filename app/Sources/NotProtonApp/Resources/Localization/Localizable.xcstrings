    "The %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "The %@ cave at %@ is not empty. This ntdll is either already patched or not the build its hash claimed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-Cave bei %2$@ ist nicht leer. Diese ntdll ist entweder bereits gepatcht oder nicht der Build, den ihr Hash angibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave %1$@ à %2$@ n'est pas vide. Cette ntdll est soit déjà corrigée, soit pas le build annoncé par son hachage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cave %1$@ a %2$@ non è vuota. Questo ntdll ha già la patch oppure non è la build indicata dal suo hash."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的代码空隙非空。此 ntdll 可能已修补，或并非哈希值所对应的版本。"
          }
        }
      }
    },
    "The %@ detour goes to %@, below its cave at %@, so writing it would land in live code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %1$@-Detour führt nach %2$@, unterhalb seiner Cave bei %3$@. Ihn zu schreiben würde aktiven Code treffen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détour %1$@ pointe vers %2$@, sous sa cave à %3$@ : l'écrire atterrirait dans du code actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ va a %2$@, sotto la sua cave a %3$@: scriverlo finirebbe nel codice in uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转目标为 %@，位于 %@ 处的代码空隙之前；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ detour is %lld bytes and the cave holds %lld, so writing it would overrun into live code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %1$@-Detour ist %2$lld Bytes groß und die Cave fasst %3$lld. Ihn zu schreiben würde in aktiven Code hineinlaufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détour %1$@ fait %2$lld octets et la cave en contient %3$lld : l'écrire déborderait sur du code actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il detour %1$@ è di %2$lld byte e la cave ne contiene %3$lld: scriverlo sconfinerebbe nel codice in uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 跳转补丁有 %lld 字节，但代码空隙仅容纳 %lld 字节；写入会覆盖现有代码，已拒绝操作。"
          }
        }
      }
    },
    "The %@ hook site at %@ holds %@ instead of %@, so the offsets do not belong to this ntdll." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %1$@-Hook-Stelle bei %2$@ enthält %3$@ statt %4$@. Die Offsets gehören also nicht zu dieser ntdll."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le point d'accroche %1$@ à %2$@ contient %3$@ au lieu de %4$@ : les décalages n'appartiennent donc pas à cette ntdll."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il punto di aggancio %1$@ a %2$@ contiene %3$@ invece di %4$@: gli offset non appartengono a questo ntdll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在 %@ 处的挂钩位置内容为 %@，而非 %@，偏移量与此 ntdll 不匹配。"
          }
        }
      }
    },
    "The %@ ntdll at %@ hashes %@ and build %@ expects %@. It is already patched, or from another Wine build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %@-ntdll unter %@ hat den Hash %@. Build %@ erwartet %@. Die Datei wurde bereits gepatcht oder stammt aus einem anderen Wine-Build."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ ntdll at %2$@ hashes %3$@ and build %4$@ expects %5$@. It is already patched, or from another Wine build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ntdll %@ situé dans %@ a pour empreinte %@. La version %@ attend %@. Le fichier est déjà corrigé ou provient d’une autre version de Wine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %@ ntdll at %@ hashes %@ and build %@ expects %@. It is already patched, or from another Wine build."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 处的 %1$@ ntdll 的哈希值为 %3$@，但构建版本 %4$@ 预期为 %5$@。该文件可能已修补，或来自其他 Wine 版本。"
          }
        }
      }
    },
    "The %@ ntdll file alignment %@ is not a power of two." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateiausrichtung %2$@ der %1$@-ntdll ist keine Zweierpotenz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'alignement de fichier %2$@ de la ntdll %1$@ n'est pas une puissance de deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
