    "This tool repairs a prefix after changing Wine runtimes or processor architectures." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Werkzeug repariert ein Präfix nach einem Wechsel der Wine-Laufzeit oder der Prozessorarchitektur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
