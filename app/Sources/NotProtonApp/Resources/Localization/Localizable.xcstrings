    "Enable Neutron in System Settings → Privacy & Security → App Management. Then return here and choose Relaunch & Continue. Setup will resume automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Neutron unter „Systemeinstellungen → Datenschutz & Sicherheit → App-Verwaltung“. Kehren Sie anschließend hierher zurück und wählen Sie „Neu starten und fortfahren“. Die Einrichtung wird automatisch fortgesetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Neutron dans Réglages Système → Confidentialité et sécurité → Gestion des apps. Revenez ici, puis choisissez Relancer et continuer. La configuration reprendra automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Neutron in Impostazioni di Sistema → Privacy e sicurezza → Gestione app. Poi torna qui e scegli Riavvia e continua. La configurazione riprenderà automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“系统设置 → 隐私与安全性 → App 管理”中启用 Neutron。然后返回此处并选择“重新启动并继续”。设置将自动继续。"
          }
        }
      }
