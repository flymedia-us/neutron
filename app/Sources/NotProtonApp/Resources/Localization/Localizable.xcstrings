    },
    "Neutron by Fly Media is a fork of NotProton by NotProtonNot (https://github.com/NotProtonNot/NotProton), released under GPLv3. It is not affiliated with or endorsed by NotProton, Valve, Apple or Highball. Highball integration is adapted from Proton-ish by MagnusPladsen (https://github.com/MagnusPladsen/Proton-ish). It uses Highball's HighballKit (GPLv3) and highball-db game data (CC0) by Gauthier Piarrette (https://github.com/gauthierpiarrette/highball). Updates use Sparkle (MIT, https://sparkle-project.org)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron von Fly Media ist ein Fork von NotProton von NotProtonNot (https://github.com/NotProtonNot/NotProton) und steht unter der GPLv3. Es ist weder mit NotProton, Valve, Apple oder Highball verbunden noch wird es von diesen unterstützt. Die Highball-Integration basiert auf Proton-ish von MagnusPladsen (https://github.com/MagnusPladsen/Proton-ish). Neutron verwendet HighballKit (GPLv3) und die highball-db-Spieldaten (CC0) von Gauthier Piarrette (https://github.com/gauthierpiarrette/highball). Updates verwenden Sparkle (MIT, https://sparkle-project.org)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron, développé par Fly Media, est un fork de NotProton par NotProtonNot (https://github.com/NotProtonNot/NotProton), publié sous GPLv3. Il n’est ni affilié à NotProton, Valve, Apple ou Highball, ni approuvé par eux. L’intégration de Highball est adaptée de Proton-ish par MagnusPladsen (https://github.com/MagnusPladsen/Proton-ish). Neutron utilise HighballKit (GPLv3) et les données de jeu highball-db (CC0) de Gauthier Piarrette (https://github.com/gauthierpiarrette/highball). Les mises à jour utilisent Sparkle (MIT, https://sparkle-project.org)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Neutron by Fly Media is a fork of NotProton by NotProtonNot (https://github.com/NotProtonNot/NotProton), released under GPLv3. It is not affiliated with or endorsed by NotProton, Valve, Apple or Highball. Highball integration is adapted from Proton-ish by MagnusPladsen (https://github.com/MagnusPladsen/Proton-ish). It uses Highball's HighballKit (GPLv3) and highball-db game data (CC0) by Gauthier Piarrette (https://github.com/gauthierpiarrette/highball). Updates use Sparkle (MIT, https://sparkle-project.org)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Neutron by Fly Media is a fork of NotProton by NotProtonNot (https://github.com/NotProtonNot/NotProton), released under GPLv3. It is not affiliated with or endorsed by NotProton, Valve, Apple or Highball. Highball integration is adapted from Proton-ish by MagnusPladsen (https://github.com/MagnusPladsen/Proton-ish). It uses Highball's HighballKit (GPLv3) and highball-db game data (CC0) by Gauthier Piarrette (https://github.com/gauthierpiarrette/highball). Updates use Sparkle (MIT, https://sparkle-project.org)."
          }
        }
      }
    },
    "Neutron cannot use Steam from a folder with a colon in its name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron kann Steam nicht aus einem Ordner verwenden, dessen Name einen Doppelpunkt enthält."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron ne peut pas utiliser Steam depuis un dossier dont le nom contient deux-points."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron non può usare Steam da una cartella con i due punti nel nome."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron 无法使用名称中含有冒号的文件夹中的 Steam。"
