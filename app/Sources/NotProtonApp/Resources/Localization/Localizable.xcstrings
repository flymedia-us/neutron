    },
    "Neutron has been removed. Steam could not be restored. Reinstall Steam from steampowered.com before using it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron wurde entfernt. Steam konnte nicht wiederhergestellt werden. Installiere Steam von steampowered.com neu, bevor du es wieder verwendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron a été supprimé. Steam n'a pas pu être restauré. Réinstallez Steam depuis steampowered.com avant de l'utiliser à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron è stato rimosso. Non è stato possibile ripristinare Steam: reinstallalo da steampowered.com prima di usarlo di nuovo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron 已移除，但需要重新下载 Steam。请联网后再次执行“修复 Steam”。"
          }
        }
      }
    },
    "Neutron is a fork of NotProtonNot/NotProton and runs games with Highball's engine. Thank you both." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron ist ein Fork von NotProtonNot/NotProton und führt Spiele mit der Highball-Engine aus. Vielen Dank an beide Projekte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron est un fork de NotProtonNot/NotProton et exécute les jeux avec le moteur Highball. Merci à ces deux projets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Neutron is a fork of NotProtonNot/NotProton and runs games with Highball's engine. Thank you both."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron 是 NotProtonNot/NotProton 的分支，并使用 Highball 的引擎运行游戏。感谢你们两者。"
          }
        }
      }
    },
    "Neutron is installed in %@. Use Repair Steam to remove it before choosing another copy of Steam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron ist in %@ installiert. Entferne es mit „Steam reparieren“, bevor du eine andere Steam-Kopie wählst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron est installé dans %@. Utilisez « Réparer Steam » pour le supprimer avant de choisir une autre copie de Steam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron è installato in %@. Usa Ripara Steam per rimuoverlo prima di scegliere un'altra copia di Steam."
