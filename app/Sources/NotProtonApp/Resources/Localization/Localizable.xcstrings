          "stringUnit" : {
            "state" : "translated",
            "value" : "此工具用于修复在更换 Wine 运行时或处理器架构后的游戏容器。"
          }
        }
      }
    },
    "This will DELETE the game's prefix." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird das Präfix des Spiels GELÖSCHT."
          }
