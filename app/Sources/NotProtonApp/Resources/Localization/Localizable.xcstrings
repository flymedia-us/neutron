          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作将删除 %lld 个游戏的容器。"
          }
        }
      }
    },
    "This will restore Steam itself to its original state but does not remove the support components used by Neutron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird Steam selbst in den Originalzustand zurückversetzt, die von Neutron verwendeten Hilfskomponenten werden aber nicht entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam lui-même sera restauré dans son état d'origine, mais les composants de support utilisés par Neutron ne seront pas supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam verrà riportato allo stato originale, ma i componenti di supporto usati da Neutron non verranno rimossi."
