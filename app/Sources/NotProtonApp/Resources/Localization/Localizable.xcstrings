        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行。请先退出游戏。"
          }
        }
      }
    },
    "%@ names the package %@, which is not declared. Declared: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nennt das Paket %2$@, das nicht deklariert ist. Deklariert: %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indique le paquet %2$@, qui n'est pas déclaré. Déclarés : %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ indica il pacchetto %2$@, che non è dichiarato. Dichiarati: %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 指定了未声明的软件包 %@。已声明：%@。"
          }
        }
      }
    },
    "%@ templates %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-Vorlagen %2$@"
          }
        },
