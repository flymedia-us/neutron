    },
    "Neutron has been partially removed, because Steam at %@ cannot be found. Delete that copy of Steam and reinstall it to fully remove Neutron." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron wurde nur teilweise entfernt, weil Steam unter %@ nicht gefunden wurde. Lösche diese Steam-Kopie und installiere Steam neu, um Neutron vollständig zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron a été partiellement supprimé, car Steam est introuvable à %@. Supprimez cette copie de Steam et réinstallez-la pour supprimer complètement Neutron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron è stato rimosso solo in parte, perché Steam in %@ non si trova. Elimina quella copia di Steam e reinstallala per rimuovere del tutto Neutron."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron 仅被部分移除，因为找不到位于 %@ 的 Steam。请删除该 Steam 并重新安装，以完全移除 Neutron。"
          }
        }
      }
    },
    "Neutron has been removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron wurde entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron a été supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
