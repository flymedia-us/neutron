        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neutron 已安装在 %@ 中。请先使用“修复 Steam”将其移除，再选择另一份 Steam。"
          }
        }
      }
    },
